# Render Blueprint — ავტომატურად ქმნის backend-ს (Docker), მონაცემთა ბაზას (PostgreSQL)
# და frontend-ს (Static Site) ერთი "New > Blueprint" მოქმედებით.
# დოკუმენტაცია: https://render.com/docs/blueprint-spec

services:
  # ---------- Django REST backend (Docker) ----------
  - type: web
    name: scsa-backend
    runtime: docker
    plan: free
    dockerfilePath: ./backend/backend/Dockerfile
    dockerContext: ./backend/backend
    healthCheckPath: /api/courses/
    envVars:
      - key: SECRET_KEY
        generateValue: true
      - key: DEBUG
        value: "False"
      # ნებისმიერ *.onrender.com სუბდომენს დაუშვებს — არ არის დამოკიდებული
      # იმაზე, თუ ზუსტად რა სახელი მიენიჭება სერვისს დეპლოიისას.
      - key: ALLOWED_HOSTS
        value: ".onrender.com"
      - key: CORS_ALLOW_ALL_ORIGINS
        value: "False"
      - key: CORS_ALLOWED_ORIGIN_REGEXES
        value: "^https://.*\\.onrender\\.com$"
      - key: CSRF_TRUSTED_ORIGINS
        value: "https://*.onrender.com"
      - key: DATABASE_URL
        fromDatabase:
          name: scsa-db
          property: connectionString

  # ---------- React frontend (Static Site) ----------
  - type: web
    name: scsa-frontend
    runtime: static
    buildCommand: npm install && npm run build
    staticPublishPath: ./build
    rootDir: frontend/frontend
    envVars:
      # თუ backend-ის სახელი/მისამართი განსხვავებული აღმოჩნდა, დეპლოიის
      # შემდეგ განაახლეთ ეს მნიშვნელობა Render-ის dashboard-ში.
      - key: REACT_APP_API_URL
        value: https://scsa-backend.onrender.com/api/
    routes:
      # React Router-ის client-side routing-ისთვის: ყველა მისამართზე index.html
      - type: rewrite
        source: /*
        destination: /index.html

databases:
  - name: scsa-db
    plan: free
    databaseName: scsa
    user: scsa
